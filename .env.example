# HTTP Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Pub/Sub Configuration
PUBSUB_ENABLED=true
PUBSUB_PROJECT_ID=your-project-id

# Topic Names (for publishing)
PUBSUB_TOPIC_COMPLETE=assessorflow.qa-generation.complete

# Subscription Names (for consuming)
PUBSUB_SUBSCRIPTION_TRIGGER=assessorflow.qa-generation.trigger

# Telemetry (Langfuse) - required for tracing
# Get keys from your Langfuse instance dashboard
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_BASE_URL=https://your-langfuse-instance.com

# OpenAI Configuration - required for LLM calls
# Using OpenRouter as provider example
OPENAI_API_KEY=sk-or-v1-your-api-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/elephant-alpha

# Cost-Optimized Model Tiers (optional - defaults to OPENAI_MODEL if not set)
# CHEAP_MODEL_ID: Used for MCQ answer/explanation generation (less expensive)
# EXPENSIVE_MODEL_ID: Used for assessment generation (higher quality)
CHEAP_MODEL_ID=openrouter/elephant-alpha
EXPENSIVE_MODEL_ID=openrouter/elephant-alpha

# LLM Parameters
OPENAI_TEMPERATURE=0.2        # 0.0-2.0, lower = more deterministic (default: 0.2)
OPENAI_MAX_OUTPUT_TOKENS=8192 # Max tokens per response (default: 8192)

# gRPC Service URLs - required for inter-service communication
SUBMISSION_SERVICE_URL=localhost:50052
KNOWLEDGE_SERVICE_URL=localhost:50053

LLM_WORKFLOW_MODE=true
LLM_TIMEOUT_SECONDS=600